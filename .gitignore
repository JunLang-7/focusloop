# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
release/
*.tsbuildinfo

# Nx
.nx/
.nx-cache/

# Test / coverage
coverage/
test-results/
playwright-report/
blob-report/

# Electron packaging
apps/desktop/release/
apps/desktop/out/

# Release artefacts.
# Generated by .github/workflows/release.yml and attached to the GitHub Release. Committing
# one meant the repository carried checksums for binaries it does not contain, and a local
# release run rewrote a tracked file.
SHA256SUMS.txt

# Logs & debug artifacts
*.log
npm-debug.log*
pnpm-debug.log*
debug-logs/
logs/
*.heapsnapshot
*.cpuprofile

# Local runtime data (local-first store must never be committed)
*.sqlite
*.sqlite3
*.db
data/
.focusloop/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Scratch
scratch/
tmp/
.tmp/
