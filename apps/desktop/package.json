{
  "name": "@focusloop/desktop",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "FocusLoop desktop client — Electron shell with an Angular renderer.",
  "author": "FocusLoop contributors",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "ng build --configuration production && node scripts/build-main.mjs",
    "build:dev": "ng build --configuration development && node scripts/build-main.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "pnpm run build:dev && electron dist/main/main.cjs",
    "serve": "pnpm run start",
    "package": "pnpm run build && electron-builder --win --config electron-builder.yml",
    "package:win:x64": "pnpm run build && electron-builder --win --x64 --config electron-builder.yml",
    "package:win:arm64": "pnpm run build && electron-builder --win --arm64 --config electron-builder.yml",
    "package:mac": "pnpm run build && electron-builder --mac dmg --config electron-builder.yml",
    "package:mac:arm64": "pnpm run build && electron-builder --mac dmg --arm64 --config electron-builder.yml",
    "package:mac:x64": "pnpm run build && electron-builder --mac dmg --x64 --config electron-builder.yml",
    "package:dir": "pnpm run build && electron-builder --dir --config electron-builder.yml",
    "package:mac:dir": "pnpm run build && electron-builder --mac --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@focusloop/agent-core": "workspace:*",
    "@focusloop/continuity": "workspace:*",
    "@focusloop/intervention-policy": "workspace:*",
    "@focusloop/learning-state": "workspace:*",
    "@focusloop/llm-provider": "workspace:*",
    "@focusloop/material-parser": "workspace:*",
    "@focusloop/persistence": "workspace:*",
    "@focusloop/shared-types": "workspace:*",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.39",
    "@angular/cli": "^20.3.39",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/compiler-cli": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@types/ws": "^8.18.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  }
}
