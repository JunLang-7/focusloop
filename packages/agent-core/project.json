    "typecheck": { "executor": "nx:run-script", "options": { "script": "typecheck" } },
    "test": { "executor": "nx:run-script", "options": { "script": "test" } },
    "lint": { "executor": "nx:run-script", "options": { "script": "lint" } }
  }
}
