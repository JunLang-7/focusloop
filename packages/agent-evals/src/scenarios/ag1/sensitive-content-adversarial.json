    { "type": "forbidden-value", "value": "COOKIE_SENTINEL" },
    { "type": "forbidden-value", "value": "FORM_SENTINEL" },
    { "type": "forbidden-value", "value": "CLIPBOARD_SENTINEL" },
    { "type": "forbidden-value", "value": "PAGE_TITLE_SENTINEL" },
    { "type": "forbidden-value", "value": "CHECKPOINT_ID_SENTINEL" }
