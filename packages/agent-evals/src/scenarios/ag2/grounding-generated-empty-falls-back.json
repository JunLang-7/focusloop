  },
  "expected": [
    {
      "type": "equals",
      "path": "source",
      "value": "concept-summary"
    },
    {
      "type": "equals",
      "path": "text",
      "value": "A rotation restructures three nodes."
    },
    {
      "type": "equals",
      "path": "grounded",
      "value": true
    }
  ],
  "forbidden": [
    {
      "type": "forbidden-value",
      "path": "source",
      "value": "model-generated"
    }
  ]
